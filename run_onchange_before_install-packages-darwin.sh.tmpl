{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Run brew bundle on Brewfile changes. Managed by chezmoi - do not edit directly.
set -euo pipefail

# Ensure brew is on PATH (chezmoi does not source shell profiles).
if [ -f /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -f /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
else
    echo "ERROR: Homebrew not found. Run chezmoi apply again after installing Homebrew." >&2
    exit 1
fi

echo "Running brew bundle..."

# Brewfile content is captured here so chezmoi detects changes and re-runs this script.
# Includes shared cross-platform packages (Brewfile) and macOS-specific additions (Brewfile.MacOS).
BREWFILE_CONTENT=$(cat <<'BREWFILE'
{{ include "Brewfile" }}

{{ include "Brewfile.MacOS" }}
BREWFILE
)

# Fetch latest formula metadata
brew update --quiet

# --upgrade: keeps Brewfile-managed packages current without touching
#            packages installed outside the Brewfile.
# || true: brew bundle exits non-zero when any package fails; we treat
#          individual failures as warnings so the overall script does not abort.
#
# mas (Mac App Store) requires an interactive App Store sign-in, and mas itself
# is one of the packages this bundle installs — so mas entries are bundled
# separately, AFTER the main install has had a chance to install mas.
printf '%s\n' "$BREWFILE_CONTENT" | grep -v '^mas ' | brew bundle install --upgrade --file=- || true

MAS_CONTENT=$(printf '%s\n' "$BREWFILE_CONTENT" | grep '^mas ' || true)
if [ -n "$MAS_CONTENT" ]; then
    if command -v mas >/dev/null 2>&1 && mas outdated >/dev/null 2>&1; then
        echo "App Store: signed in"
        printf '%s\n' "$MAS_CONTENT" | brew bundle install --upgrade --file=- || true
    else
        echo "WARNING: Not signed in to App Store. Skipping mas entries."
        echo "         Sign in via App Store app, then run:"
        echo "         chezmoi state delete-bucket --bucket=entryState && chezmoi apply"
    fi
fi

echo "brew bundle complete."
{{- end }}
