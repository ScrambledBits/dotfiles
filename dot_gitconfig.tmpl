# Managed by chezmoi

[user]
    name = {{ .name }}
    email = {{ .email }}
{{ if .gitSigningKey }}
    signingkey = {{ .gitSigningKey }}
{{ end }}

[core]
    editor = nvim
    pager = delta
    autocrlf = input
    hooksPath = ~/.config/git/hooks

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[fetch]
    prune = true
    writeCommitGraph = true     # speeds up git log on large repos

[merge]
    tool = nvimdiff
    conflictstyle = zdiff3      # upgraded from diff3; shows base in 3-way conflicts

[diff]
    tool = nvimdiff
    colorMoved = default

[branch]
    sort = -committerdate       # most recent branches first in git branch -l

[rerere]
    enabled = true              # remember and replay recorded conflict resolutions
{{ if .gitSigningKey }}
[commit]
    gpgsign = true

[tag]
    gpgsign = true
{{ end }}
[delta]
    navigate = true
    light = false
    side-by-side = true
    line-numbers = true

[interactive]
    diffFilter = delta --color-only

[alias]
    undo = reset --soft HEAD~1
    amend = commit --amend --no-edit

{{ if eq .chezmoi.os "darwin" }}
[credential]
    helper = osxkeychain
{{ else }}
[credential]
    helper = cache --timeout=3600
{{ end }}

[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
