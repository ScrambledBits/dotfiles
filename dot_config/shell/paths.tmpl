# Managed by chezmoi — Homebrew prefix, templated per OS/arch (avoids forking
# `brew --prefix` on every shell start); falls back to a live lookup if the
# standard location is missing (e.g. a non-standard Homebrew install).
{{- if eq .chezmoi.os "darwin" }}
{{- if eq .chezmoi.arch "arm64" }}
BREW_PREFIX="/opt/homebrew"
{{- else }}
BREW_PREFIX="/usr/local"
{{- end }}
{{- else }}
BREW_PREFIX="/home/linuxbrew/.linuxbrew"
{{- end }}
# Homebrew's own installer prefers /home/linuxbrew/.linuxbrew on Linux but
# falls back to a per-user $HOME/.linuxbrew when it can't create that shared
# prefix (e.g. no sudo) — check both before falling back to a live lookup,
# which can't find brew either if nothing has put it on PATH yet.
[[ -x "$BREW_PREFIX/bin/brew" ]] || BREW_PREFIX="$HOME/.linuxbrew"
[[ -x "$BREW_PREFIX/bin/brew" ]] || BREW_PREFIX="$(command -v brew &>/dev/null && brew --prefix)"
export BREW_PREFIX

export PATH="$BREW_PREFIX/bin:$BREW_PREFIX/sbin:$HOME/.local/bin:$PATH"

# ffmpeg-full is keg-only, so the linked `ffmpeg` is Homebrew's slim build
# (no libass, zscale or libplacebo). Put the full one first when installed.
if [[ -x "$BREW_PREFIX/opt/ffmpeg-full/bin/ffmpeg" ]]; then
    export PATH="$BREW_PREFIX/opt/ffmpeg-full/bin:$PATH"
{{- if eq .chezmoi.os "darwin" }}
    # libplacebo dlopens libvulkan by bare name, and dyld doesn't search the
    # Homebrew lib dir. Keep the pre-2023 defaults after it. Scripts started
    # via /usr/bin/env or /bin/bash lose this (SIP strips DYLD_*): they must
    # export it themselves.
    export DYLD_FALLBACK_LIBRARY_PATH="$BREW_PREFIX/lib:/usr/local/lib:/usr/lib"
{{- end }}
fi
