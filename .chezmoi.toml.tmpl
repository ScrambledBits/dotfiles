sourceDir = "{{ .chezmoi.sourceDir }}"

[git]
    autoCommit = true
    autoPush = false

[edit]
    command = "nvim"

[data]
    name = {{ promptStringOnce . "name" "Full Name" | quote }}
    email = {{ promptStringOnce . "email" "Email address" | quote }}
    github = {{ promptStringOnce . "github" "GitHub username" | quote }}
    timezone = {{ promptStringOnce . "timezone" "Timezone (e.g. America/Mexico_City)" | quote }}
    # OpenPGP key ID for git commit signing (gpg --list-secret-keys --keyid-format long).
    # Empty string skips commit signing configuration.
    gitSigningKey = {{ promptStringOnce . "gitSigningKey" "GPG signing key ID (empty to skip)" | quote }}

# Values persist per machine in ~/.config/chezmoi/chezmoi.toml; promptStringOnce
# only asks when a value is missing. To change one, edit that file directly.
