sourceDir = "{{ .chezmoi.sourceDir }}"

[git]
    autoCommit = true
    autoPush = false

[edit]
    command = "nvim"

[data]
    name = {{ promptStringOnce . "name" "Full Name" | quote }}
    email = {{ promptStringOnce . "email" "Email address" | quote }}
    github = {{ promptStringOnce . "github" "GitHub username" | quote }}
    # SSH public key path for git commit signing (Ed25519 recommended), e.g.
    # "key::ssh-ed25519 AAAA... user@host". Leave blank (just press enter) to skip.
    gitSigningKey = {{ promptStringOnce . "gitSigningKey" "SSH signing key (blank to skip)" "" | quote }}

# Machine-specific overrides: run `chezmoi edit-config` on this machine to change
# any [data] value above (e.g. a work email or a per-machine signing key) without
# editing tracked files.
