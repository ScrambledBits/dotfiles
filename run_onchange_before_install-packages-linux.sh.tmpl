{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
# Run brew bundle on Brewfile changes (Linux: cask and mas entries skipped).
# Managed by chezmoi - do not edit directly.
set -euo pipefail

# Add Homebrew to PATH (chezmoi does not source shell profiles).
if [ -f /home/linuxbrew/.linuxbrew/bin/brew ]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
elif [ -f "$HOME/.linuxbrew/bin/brew" ]; then
    eval "$("$HOME/.linuxbrew/bin/brew" shellenv)"
else
    echo "ERROR: Homebrew not found. Run chezmoi apply again after installing Homebrew." >&2
    exit 1
fi

echo "Running brew bundle..."

# Brewfile content is captured here so chezmoi detects changes and re-runs this script.
# The shared Brewfile has no cask/mas lines (those live in the macOS-only Brewfile.MacOS),
# so nothing needs filtering for Linux here.
BREWFILE_CONTENT=$(cat <<'BREWFILE'
{{ include "Brewfile" }}
BREWFILE
)

# Fetch latest formula metadata; brew bundle installs and upgrades by default.
brew update --quiet

# || true: brew bundle exits non-zero when any package fails; we treat
#          individual failures as warnings so the overall script does not abort.
printf '%s\n' "$BREWFILE_CONTENT" | brew bundle install --file=- || true

echo "brew bundle complete."
{{- end }}
